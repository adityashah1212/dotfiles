{{ if eq .chezmoi.os "linux" -}}
{{- if or (eq .chezmoi.osRelease.id "debian") (contains "debian" (.chezmoi.osRelease.idLike | default "")) -}}
#!/bin/bash

set -euo pipefail

export DEBIAN_FRONTEND=noninteractive
export PATH="${PATH}:/snap/bin:${HOME}/.cargo/bin:${HOME}/.deno/bin"

write_apt_source() {
	local file=$1 types=$2 uris=$3 suites=$4 components=$5 key_url=$6
	local raw armored

	raw=$(mktemp)
	curl -fsSL "$key_url" -o "$raw"

	if grep -q 'BEGIN PGP PUBLIC KEY BLOCK' "$raw"; then
		armored=$(cat "$raw")
	else
		armored=$(gpg --enarmor <"$raw" | sed 's/ARMORED FILE/PUBLIC KEY BLOCK/')
	fi
	rm -f "$raw"

	{
		printf 'Types: %s\n' "$types"
		printf 'URIs: %s\n' "$uris"
		printf 'Suites: %s\n' "$suites"
		if [ -n "$components" ]; then
			printf 'Components: %s\n' "$components"
		fi
		printf 'Signed-By:\n'
		printf '%s\n' "$armored" | sed -e 's/^[[:space:]]*$/./' -e 's/^/ /'
	} | sudo tee "/etc/apt/sources.list.d/${file}.sources" >/dev/null
}

snap_install() {
	local name=$1
	shift
	snap list "$name" >/dev/null 2>&1 || sudo snap install "$name" "$@"
}

pipx_install() {
	local name=$1
	pipx list --short 2>/dev/null | awk '{print $1}' | grep -qx "$name" ||
		pipx install "$name"
}

deno_install() {
	local name=$1
	deno install --global --force --allow-all --root "$HOME/.deno" \
		--name "$name" "npm:$name"
}

sudo apt-get update
sudo apt-get install -y --no-install-recommends ca-certificates curl gnupg software-properties-common
{{ range .packages.debian.apt.ppa }}
sudo add-apt-repository -y {{ printf "ppa:%s" . | quote }}
{{- end }}
{{ range .packages.debian.apt.sources }}
write_apt_source {{ .file | quote }} {{ .types | quote }} {{ .uris | replace "@@CODENAME@@" $.chezmoi.osRelease.versionCodename | quote }} {{ .suites | replace "@@CODENAME@@" $.chezmoi.osRelease.versionCodename | quote }} {{ (or .components "") | quote }} {{ .key | quote }}
{{- end }}

sudo apt-get update
sudo apt-get install -y --no-install-recommends{{ range .packages.debian.packages }} {{ . | quote }}{{ end }}

if ! command -v snap >/dev/null 2>&1; then
	sudo apt-get install -y --no-install-recommends snapd
	sudo systemctl enable --now snapd.socket
	sudo snap wait system seed.loaded
fi
{{ range .packages.debian.snap }}
snap_install {{ .name | quote }}{{ if .classic }} --classic{{ end }}{{ if hasKey . "channel" }} {{ printf "--channel=%s" .channel | quote }}{{ end }}
{{- end }}
{{ range .packages.debian.pipx }}
pipx_install {{ . | quote }}
{{- end }}
{{ range .packages.debian.deno }}
deno_install {{ . | quote }}
{{- end }}
{{ end -}}
{{ end -}}
